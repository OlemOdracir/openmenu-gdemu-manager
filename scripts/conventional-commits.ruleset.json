{
  "name": "Conventional Commits for all branches",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {"include": ["~ALL"], "exclude": []}
  },
  "rules": [
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Conventional Commit header, including merges and reverts",
        "negate": false,
        "operator": "regex",
        "pattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([A-Za-z0-9][A-Za-z0-9._/-]*\\))?!?: \\S([^\\r\\n]*\\S)?(\\r?\\n|$)"
      }
    },
    {
      "type": "commit_message_pattern",
      "parameters": {
        "name": "Commit header at most 100 characters",
        "negate": false,
        "operator": "regex",
        "pattern": "^[^\\r\\n]{1,100}(\\r?\\n|$)"
      }
    }
  ]
}
